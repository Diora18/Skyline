PORT=5000
MONGO_URI=mongodb://localhost:27017/skyline_ssa
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
NODE_ENV=development
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
# Optional: only needed if you configure Razorpay webhooks.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Keep false when using Razorpay test checkout. Enable only for local demo simulation.
PAYMENT_SIMULATION=false
